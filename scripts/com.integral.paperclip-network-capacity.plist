<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.integral.paperclip-network-capacity</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/sbin/sysctl</string>
        <string>-w</string>
        <string>net.inet.ip.portrange.first=10000</string>
        <string>net.inet.ip.portrange.hifirst=10000</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/var/log/paperclip-network-capacity.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/paperclip-network-capacity.error.log</string>
</dict>
</plist>
